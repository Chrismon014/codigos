local AutoBossStatus = BossesTab:Paragraph({ Title = "Estado", Desc = "Inactivo" })
local AutoBossHealth = BossesTab:Paragraph({ Title = "Vida", Desc = "0 / 0" })

do
    local BOSS_NAMES = { Boss1 = true, Boss2 = true, Boss3 = true, Boss4 = true, Boss5 = true, Boss6 = true }
    local BossCache = { Arena = nil }

    -- Mismo sistema de ataque que el Halloween Boss (tabs.boss.attack)
    local autoBossCtx = {
        Data = { LastPunch = 0, PunchInterval = 0.01 },
        BossLabel = AutoBossStatus,
        HealthLabel = AutoBossHealth,
        BossLabelPrefix = "Boss: ",
        runtime = {},
        getBossDisplayName = function(model) return model.Name end,
        getBossHealth = function(health) return health and health.Value or 0 end,
        getBossMaxHealth = function() return 0 end,
    }

    local function setAutoBossStatus(text)
        pcall(function() AutoBossStatus:SetDesc(text) end)
    end

    local function getBossTargets()
        local bosses = {}
        local myChar = LP.Character
        if not BossCache.Arena or not BossCache.Arena.Parent then
            local events = Workspace:FindFirstChild("Events")
            BossCache.Arena = events and events:FindFirstChild("BossArena")
            if not BossCache.Arena then
                for _, v in ipairs(Workspace:GetDescendants()) do
                    if v.Name == "BossArena" and v:IsA("Folder") then
                        BossCache.Arena = v
                        break
                    end
                end
            end
        end
        if BossCache.Arena then
            for _, obj in ipairs(BossCache.Arena:GetChildren()) do
                if obj:IsA("Model") and obj ~= myChar and BOSS_NAMES[obj.Name] then
                    local hpVal = nil
                    for _, v in ipairs(obj:GetDescendants()) do
                        if (v:IsA("NumberValue") or v:IsA("IntValue")) and (string.find(string.lower(v.Name), "health") or string.find(string.lower(v.Name), "hp") or v.Name == "Value") then
                            hpVal = v
                            break
                        end
                    end
                    table.insert(bosses, { model = obj, healthValue = hpVal })
                end
            end
        end
        return bosses
    end

    local function ensureBossHitbox(model)
        local existing = model:FindFirstChild("R1Q_Hitbox")
        if existing and existing:IsA("BasePart") then return existing end
        local rootPart = model:FindFirstChild("HumanoidRootPart")
            or model:FindFirstChild("Torso")
            or model.PrimaryPart
            or model:FindFirstChildWhichIsA("BasePart")
        if not rootPart then return nil end

        local hitbox = Instance.new("Part")
        hitbox.Name = "R1Q_Hitbox"
        hitbox.Size = Vector3.new(12, 12, 12)
        hitbox.Transparency = 1
        hitbox.CanCollide = false
        hitbox.CanQuery = true
        hitbox.CanTouch = true
        hitbox.Massless = true
        hitbox.Anchored = false
        hitbox.CFrame = rootPart.CFrame

        local weld = Instance.new("WeldConstraint")
        weld.Part0 = rootPart
        weld.Part1 = hitbox
        weld.Parent = hitbox

        hitbox.Parent = model
        return hitbox
    end

    local function getAliveTarget()
        for _, t in ipairs(getBossTargets()) do
            if (not t.healthValue) or t.healthValue.Value > 0 then
                return t
            end
        end
        return nil
    end

    local function startAutoFarmBoss()
        if State.AutoBossFarm then return end
        State.AutoBossFarm = true
        -- Evita choque con el farm de Halloween
        pcall(function()
            if tabs.boss.Halloween.Data.Running then
                tabs.boss.Halloween.AutoFarmSwitch:Set(false)
            end
        end)
        task.spawn(function()
            while State.AutoBossFarm do
                pcall(function()
                    local t = getAliveTarget()
                    if not t then
                        setAutoBossStatus("Esperando boss...")
                        pcall(function() AutoBossHealth:SetDesc("0 / 0") end)
                        return
                    end
                    local hitbox = t.model:FindFirstChild("BossDamageHitbox", true)
                    if not (hitbox and hitbox:IsA("BasePart")) then
                        hitbox = ensureBossHitbox(t.model)
                    end
                    if not hitbox then return end
                    tabs.boss.attack(autoBossCtx, t.model, t.healthValue, nil, hitbox)
                end)
                task.wait(0.01)
            end
        end)
    end

    local function stopAutoFarmBoss()
        State.AutoBossFarm = false
        if BossCache.Arena then
            for _, obj in ipairs(BossCache.Arena:GetChildren()) do
                if obj:IsA("Model") then
                    local hb = obj:FindFirstChild("R1Q_Hitbox")
                    if hb then hb:Destroy() end
                end
            end
        end
        local char = LP.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then pcall(function() hrp.Anchored = false end) end
        setAutoBossStatus("Inactivo")
        pcall(function() AutoBossHealth:SetDesc("0 / 0") end)
    end

    BossesTab:Toggle({
        Title = "Auto Farm Boss",
        Desc = "Farmea los Boss1 a Boss6 de la arena (script R1Q)",
        Value = false,
        Callback = function(state)
            if state then startAutoFarmBoss() else stopAutoFarmBoss() end
        end
    })
end

