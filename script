                                    dragWeld.Part0 = hrp
                                    dragWeld.Part1 = cachedDragPart
                                    dragWeld.Parent = hrp
                                end
                            end
                        end
                    else
                        hum.WalkSpeed = originalSpeed
                        if forwardDir then
                            local targetVel = forwardDir * originalSpeed
                            hrp.AssemblyLinearVelocity = Vector3.new(targetVel.X, hrp.AssemblyLinearVelocity.Y, targetVel.Z)
                        end
                    end
