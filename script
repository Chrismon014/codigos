local function isQuestComplete(questFolder)
    local requirements = questFolder:FindFirstChild("requirements")
    if not requirements then return false end
    
    local reqList = requirements:GetChildren()
    if #reqList == 0 then return false end

    for _, req in ipairs(reqList) do
        local progressVal = req:FindFirstChild("progress")
        if progressVal and (progressVal:IsA("IntValue") or progressVal:IsA("NumberValue")) then
            if progressVal.Value < req.Value then
                return false
            end
        else
            return false
        end
    end
    return true
end

